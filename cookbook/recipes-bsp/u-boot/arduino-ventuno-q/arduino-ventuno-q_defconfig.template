CONFIG_ARM=y
# CONFIG_ARM64_CRC32 is not set
CONFIG_BOOTFILE="Image"
CONFIG_ARCH_EFI_ARM=y
CONFIG_NR_DRAM_BANKS=8
CONFIG_ENV_SIZE=0x4000
CONFIG_DEFAULT_DEVICE_TREE="efi-arm_app"
CONFIG_DEBUG_UART_BASE=0x0
CONFIG_DEBUG_UART_CLOCK=0
CONFIG_DEBUG_UART=y
CONFIG_TARGET_EFI_ARM_APP64=y
CONFIG_ULIB=y
CONFIG_EXAMPLES=y
# CONFIG_RUST_EXAMPLES is not set
# CONFIG_CONSOLE_PAGER is not set
# CONFIG_BOOTM_FAKE_GO is not set
CONFIG_EFI_CLIENT=y
CONFIG_EFI_APP_64BIT=y
CONFIG_EFI_RAM_SIZE=0x20000000
CONFIG_FIT=y
CONFIG_BOOTSTD_FULL=y
CONFIG_SHOW_BOOT_PROGRESS=y
CONFIG_OF_SYSTEM_SETUP=y
CONFIG_FDT_SIMPLEFB=y
CONFIG_USE_BOOTARGS=y
CONFIG_BOOTCOMMAND="bootflow scan -lbp"
CONFIG_SYS_PBSIZE=532
CONFIG_SYS_CONSOLE_INFO_QUIET=y
CONFIG_LOG=y
CONFIG_LOGF_FUNC=y
CONFIG_DISPLAY_BOARDINFO_LATE=y
CONFIG_CYCLIC_MAX_CPU_TIME_US=50000
CONFIG_BOARD_EARLY_INIT_R=y
CONFIG_CMD_SMBIOS=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_MEMINFO=y
CONFIG_CMD_MEMINFO_MAP=y
CONFIG_CMD_DM=y
CONFIG_CMD_LSBLK=y
CONFIG_CMD_CAT=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_TIME=y
CONFIG_CMD_KASLRSEED=y
CONFIG_CMD_HASH=y
CONFIG_CMD_EXT4_WRITE=y
CONFIG_MAC_PARTITION=y
CONFIG_OF_LIVE=y
CONFIG_ENV_OVERWRITE=y
CONFIG_USE_BOOTFILE=y
CONFIG_NO_NET=y
CONFIG_SYSCON=y
CONFIG_DM_RNG=y
CONFIG_SYSRESET=y
CONFIG_CONSOLE_TRUETYPE=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_CONSOLE_SCROLL_LINES=5
CONFIG_FAT_WRITE=y
CONFIG_CMD_DHRYSTONE=y
CONFIG_BLK=y

CONFIG_CMD_EFIDEBUG=y
CONFIG_BOOTCOMMAND="fatload efi 0:42 0xf60000000 boot.scr.uimg; source 0xf60000000"
CONFIG_USE_BOOTCOMMAND=y
CONFIG_LOADADDR=0x1000000
CONFIG_CMD_EXT2=y
CONFIG_SYS_RELOC_GD_ENV_ADDR=y
CONFIG_REGMAP=y
CONFIG_SAVEENV=y
CONFIG_CMD_SAVEENV=y
# CONFIG_ENV_IS_IN_EFI_MEDIA is not set
# CONFIG_ENV_EFI_MEDIA_DEVICE is not set
CONFIG_ENV_IS_IN_FAT=y
CONFIG_ENV_FAT_INTERFACE="efi"
CONFIG_ENV_FAT_DEVICE_AND_PART="0:42"
# CONFIG_VIDEO is not set
# CONFIG_DM_VIDEO is not set
# CONFIG_VIDEO_EFI is not set
# CONFIG_DEBUG_EFI_CONSOLE is not set
# CONFIG_DISABLE_CONSOLE is not set

# enable these for log debugging
# CONFIG_LOG=y
# CONFIG_LOG_CONSOLE=y
# CONFIG_LOG_MAX_LEVEL=9
# CONFIG_LOGLEVEL=9
# CONFIG_LOG_DEFAULT_LEVEL=9
# CONFIG_DM_DEBUG=y

# CONFIG_ZBOOT is not set
CONFIG_CMD_BOOTEDK=y
CONFIG_TPM=y
CONFIG_TPM_V2=y
CONFIG_TPM2_MMIO=y
CONFIG_CMD_TPM=y
CONFIG_CMD_TPM_V2=y

# bootcount limit
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_CMD_BOOTCOUNT=y
CONFIG_BOOTCOUNT_BOOTLIMIT=3

# Behälter
CONFIG_MANUAL_MODEL="Arduino Ventuno Q"
CONFIG_LOCALVERSION="-{{dName}}-v{{v1}}.{{v2}}.{{v3}}"
# CONFIG_LOCALVERSION_AUTO is not set
